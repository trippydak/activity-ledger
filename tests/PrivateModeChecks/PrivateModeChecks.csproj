    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../ActivityLedger/Native/*.cs" Link="Native/%(Filename)%(Extension)" />
    <Compile Include="../../ActivityLedger/Browser/BrowserBridge.cs" Link="Browser/BrowserBridge.cs" />
    <Compile Include="../../ActivityLedger/Tracking/ActivityClassifier.cs" Link="Tracking/ActivityClassifier.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
